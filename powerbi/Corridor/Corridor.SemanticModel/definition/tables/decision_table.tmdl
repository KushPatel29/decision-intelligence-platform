		summarizeBy: none
		sourceColumn: predicted_treated_trips

	column predicted_baseline_trips
		dataType: double
		summarizeBy: none
		sourceColumn: predicted_baseline_trips

	column incremental_trips_raw
		dataType: double
		summarizeBy: none
		sourceColumn: incremental_trips_raw

	column incremental_retention_90d
		dataType: double
		summarizeBy: none
		sourceColumn: incremental_retention_90d

	column incremental_value_days31_90
		dataType: double
		summarizeBy: none
		sourceColumn: incremental_value_days31_90

