table decision_table

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Selected contacts' = DISTINCTCOUNT(decision_table[customer_id])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Expected additional trips' = SUM(decision_table[incremental_trips])
		formatString: #,0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Expected incentive costs' = SUM(decision_table[cost])
		formatString: $#,0.00

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Expected net contribution' = SUM(decision_table[net_contribution])
		formatString: $#,0.00

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Net ROI' = DIVIDE([Expected net contribution], [Expected incentive costs])
		formatString: 0.0%

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Points awarded' = SUM(decision_table[points])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure Customers = COUNTROWS(customer_360)
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Average projected value' = AVERAGE(customer_360[clv_12m])
		formatString: $#,0.00

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure Trips = SUM(monthly_performance[trips])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure Revenue = SUM(monthly_performance[revenue])
		formatString: $#,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure Utilization = DIVIDE(SUM(zone_capacity[baseline_forecast])+SUM(zone_capacity[allocated_trips]),SUM(zone_capacity[capacity_trips]))
		formatString: 0.0%

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Remaining headroom' = SUM(zone_capacity[remaining_with_reserve])
		formatString: #,0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Mean price demand index' = AVERAGE(pricing_scenarios[demand_index])
		formatString: 0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Mean response lift' = AVERAGE(experiment_results[difference])
		formatString: 0.0%

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Test AUC' = AVERAGE(model_metrics[roc_auc])
		formatString: 0.000

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Mean price revenue index' = AVERAGE(pricing_scenarios[revenue_index])
		formatString: 0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Loyalty additional trips' = CALCULATE([Expected additional trips], decision_table[offer_id] = "loyalty_500")
		formatString: #,0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Mean test Brier' = AVERAGE(model_metrics[brier])
		formatString: 0.000

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'High inactivity risk' = COUNTROWS(FILTER(customer_360, customer_360[churn_probability] > 0.5))
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Digital engagements' = SUM(customer_360[digital_events_30d])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Points redeemed' = SUM(loyalty_ledger[points_redeemed])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Points balance' = SUM(loyalty_ledger[points_balance])
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Hourly forecast trips' = SUM(zone_hour_forecast[forecast_trips])
		formatString: #,0.0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Price contribution change' = SUM(price_allocation[incremental_contribution])
		formatString: $#,0.00

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Consumer surplus change' = SUM(price_allocation[consumer_surplus_change])
		formatString: $#,0.00

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Effect interval lower' = AVERAGE(experiment_results[ci_low])
		formatString: 0.0%

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Effect interval upper' = AVERAGE(experiment_results[ci_high])
		formatString: 0.0%

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Minimum adjusted p' = MIN(experiment_results[p_adjusted])
		formatString: 0.0000

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Mean feature PSI' = AVERAGE(feature_drift[psi])
		formatString: 0.000

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Registered models' = COUNTROWS(model_registry)
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Model acceptance passes' = COUNTROWS(FILTER(quality_gate, quality_gate[passed] = TRUE()))
		formatString: #,0

	/// Synthetic portfolio result. Forecasts do not represent measured business impact.
	measure 'Candidate version' = MAX(model_registry[version])
		formatString: #,0

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column offer_id
		dataType: string
		summarizeBy: none
		sourceColumn: offer_id

	column incremental_response
		dataType: double
		summarizeBy: none
		sourceColumn: incremental_response

	column predicted_treated_trips
