		dataType: int64
		summarizeBy: none
		sourceColumn: candidate_id

	partition decision_table = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/kush2/decision-intelligence-platform/outputs/powerbi/decision_table.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"customer_id", type text}, {"offer_id", type text}, {"incremental_response", type number}, {"predicted_treated_trips", type number}, {"predicted_baseline_trips", type number}, {"incremental_trips_raw", type number}, {"incremental_retention_90d", type number}, {"incremental_value_days31_90", type number}, {"enrollment_probability", type number}, {"redemption_probability", type number}, {"eligible", type logical}, {"home_zone", Int64.Type}, {"avg_toll", type number}, {"clv_12m", type number}, {"rfm_segment", type text}, {"propensity_probability", type number}, {"trips_90d", Int64.Type}, {"offer_name", type text}, {"period", type text}, {"discount_pct", type number}, {"inventory", Int64.Type}, {"incremental_trips", type number}, {"cost", type number}, {"points", Int64.Type}, {"zone_id", Int64.Type}, {"incremental_gross_contribution", type number}, {"net_contribution", type number}, {"network_value", type number}, {"objective_value", type number}, {"candidate_id", Int64.Type}}, "en-CA")
				in
				    Typed
