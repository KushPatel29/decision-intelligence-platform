{
  "name": "Corridor / Night signal",
  "dataColors": [
    "#4BDCD5",
    "#9399FF",
    "#FFC773",
    "#69ACEA",
    "#B78CDA",
    "#A9BFCE"
  ],
  "background": "#081522",
  "foreground": "#EEF8FF",
  "tableAccent": "#4BDCD5",
  "visualStyles": {
