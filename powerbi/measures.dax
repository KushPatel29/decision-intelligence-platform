Selected Contacts = DISTINCTCOUNT(decision_table[customer_id])
Expected Additional Trips = SUM(decision_table[incremental_trips])
Expected Incentive Cost = SUM(decision_table[cost])
Expected Net Contribution = SUM(decision_table[net_contribution])
Expected Net ROI = DIVIDE([Expected Net Contribution], [Expected Incentive Cost])
Customer Count = DISTINCTCOUNT(customer_360[customer_id])
Average Projected Value = AVERAGE(customer_360[clv_12m])
Expected Capacity Use = DIVIDE(SUM(zone_capacity[baseline_forecast]) + SUM(zone_capacity[allocated_trips]), SUM(zone_capacity[capacity_trips]))
Historical Trips = SUM(monthly_performance[trips])
Historical Revenue = SUM(monthly_performance[revenue])
Historical Savings = SUM(monthly_performance[savings])
Trial Response Rate = AVERAGE(campaign_result[response])
Mean Trial Net Contribution = AVERAGE(campaign_result[net_contribution])
