	/// Plan KPIs: expected value with its parts, spend against budget, contacts against the limit, and net ROI against its floor.
	measure 'HTML KPIs p1_plan' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(4,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Expected value</span>" & "<span class='pill info'>" & FORMAT([Value per incentive dollar], "0.0") & "x spend" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Expected value]), "—", FORMAT([Expected value], "$#,0")) & "</div>" & "<div class='seg'>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Expected 30-day net]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#3987e5'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Expected later value]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#199e70'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Relief value]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#c98500'></i>" & "</div>" & "<div class='d'>" & "<span class='lg'><i style='background:#3987e5'></i>30-day " & FORMAT([Expected 30-day net], "$#,0") & "</span>" & "<span class='lg'><i style='background:#199e70'></i>days 31-90 " & FORMAT([Expected later value], "$#,0") & "</span>" & "<span class='lg'><i style='background:#c98500'></i>relief " & FORMAT([Relief value], "$#,0") & "</span>" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Incentive spend</span>" & "<span class='pill info'>" & FORMAT([Budget used], "0%") & " used" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Incentive spend]), "—", FORMAT([Incentive spend], "$#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Incentive spend], [Budget])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & "of the " & FORMAT([Budget], "$#,0") & " budget" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Contacts</span>" & "<span class='pill info'>" & "limit " & FORMAT([Contact limit], "#,0") & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Contacts]), "—", FORMAT([Contacts], "#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Contacts], [Contact limit])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & FORMAT(DIVIDE([Contacts], [Eligible customers]), "0%") & " of " & FORMAT([Eligible customers], "#,0") & " eligible customers" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Net ROI · 30 days</span>" & IF([Net ROI] >= [ROI floor], "<span class='pill good'>✓ above floor</span>", "<span class='pill warn'>✕ below floor</span>") & "</div><div class='v'>" & IF(ISBLANK([Net ROI]), "—", FORMAT([Net ROI], "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Net ROI], MAX([Net ROI], [ROI floor]) * 1.12)) * 100)), "0") & "%;background:" & IF(([Net ROI]) >= ([ROI floor]), "#3987e5", "#c98500") & "'></i><b style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE([ROI floor], MAX([Net ROI], [ROI floor]) * 1.12)) * 100)), "0") & "%'></b></div>" & "<div class='d'>" & "30-day net " & FORMAT([Expected 30-day net], "$#,0") & " on " & FORMAT([Incentive spend], "$#,0") & "</div></div>"
			    & "</div></div>"
		lineageTag: a2be86e9-7ce0-54bb-8dba-3555aed2e636
		displayFolder: 11 HTML panels

	/// Contact KPIs: extra trips by travel period, points against the cap, estimate uncertainty and congestion relief.
	measure 'HTML KPIs p2_contacts' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(4,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Extra trips</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Extra trips]), "—", FORMAT([Extra trips], "#,0")) & "</div>" & "<div class='seg'>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Extra peak trips]), MAX(0, [Extra peak trips]) + MAX(0, [Extra off-peak trips]) + MAX(0, [Extra weekend trips]))) * 100)), "0") & "%;background:#3987e5'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Extra off-peak trips]), MAX(0, [Extra peak trips]) + MAX(0, [Extra off-peak trips]) + MAX(0, [Extra weekend trips]))) * 100)), "0") & "%;background:#d95926'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Extra weekend trips]), MAX(0, [Extra peak trips]) + MAX(0, [Extra off-peak trips]) + MAX(0, [Extra weekend trips]))) * 100)), "0") & "%;background:#199e70'></i>" & "</div>" & "<div class='d'>" & "<span class='lg'><i style='background:#3987e5'></i>peak " & FORMAT([Extra peak trips], "+#,0;-#,0") & "</span>" & "<span class='lg'><i style='background:#d95926'></i>off-peak " & FORMAT([Extra off-peak trips], "+#,0;-#,0") & "</span>" & "<span class='lg'><i style='background:#199e70'></i>weekend " & FORMAT([Extra weekend trips], "+#,0;-#,0") & "</span>" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Offers in use</span>" & "" & "</div><div class='v'>" & FORMAT([Offers in plan], "0") & " of " & FORMAT(COUNTROWS(ALL(dim_offer)), "0") & "</div>" & "<div class='dots'>" & CONCATENATEX(GENERATESERIES(1, MAX(1, COUNTROWS(ALL(dim_offer)))), IF([Value] <= [Offers in plan], "<i class='on'></i>", "<i></i>"), "", [Value], ASC) & "</div>" & "<div class='d'>" & IF([Points awarded] = 0, "no loyalty points: not worth a contact under these limits", FORMAT([Points awarded], "#,0") & " points of the " & FORMAT([Points cap], "#,0") & " cap") & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Uncertainty per contact</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Mean uncertainty]), "—", FORMAT([Mean uncertainty], "$#,0.00")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Mean uncertainty], DIVIDE([Expected value], [Contacts]))) * 100)), "0") & "%;background:" & IF((DIVIDE([Mean uncertainty], DIVIDE([Expected value], [Contacts]))) >= 1.0, "#c98500", "#3987e5") & "'></i></div>" & "<div class='d'>" & "bootstrap sd against " & FORMAT(DIVIDE([Expected value], [Contacts]), "$#,0.00") & " value per contact" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Congestion relief</span>" & "<span class='pill info'>" & FORMAT(DIVIDE([Relief value], [Expected value]), "0.0%") & " of value" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Relief value]), "—", FORMAT([Relief value], "$#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Relief value], [Expected value])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & FORMAT([Rush-hour trips per workday], "+#,0;-#,0") & " rush-hour trips a workday onto the 407" & "</div></div>"
			    & "</div></div>"
		lineageTag: 2c881bbb-1b04-5973-906f-4b84d686f952
		displayFolder: 11 HTML panels

	/// Customer KPIs: customers by segment, travel propensity, inactivity risk and the share the plan contacts.
	measure 'HTML KPIs p3_customers' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(4,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Customers</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Customers]), "—", FORMAT([Customers], "#,0")) & "</div>" & "<div class='sp'>" & CONCATENATEX(VALUES(customer_segments[segment_order]), VAR vMax = MAXX(ALL(customer_segments[segment_order]), CALCULATE([Customers])) RETURN "<i title='" & CALCULATE(MAX(customer_segments[rfm_segment])) & "' style='height:" & FORMAT(MAX(0, MIN(100, (DIVIDE(CALCULATE([Customers]), vMax)) * 100)), "0") & "%'></i>", "", customer_segments[segment_order], ASC) & "</div>" & "<div class='d'>" & "by segment, Champions to Dormant" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Travel propensity</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Mean travel propensity]), "—", FORMAT([Mean travel propensity], "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Mean travel propensity]) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & "mean calibrated chance of a trip in 30 days" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Inactivity risk</span>" & IF([Mean inactivity risk] < 0.25, "<span class='pill good'>✓ low</span>", "<span class='pill warn'>▲ elevated</span>") & "</div><div class='v'>" & IF(ISBLANK([Mean inactivity risk]), "—", FORMAT([Mean inactivity risk], "0.0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Mean inactivity risk]) * 100)), "0") & "%;background:" & IF(([Mean inactivity risk]) >= 0.25, "#c98500", "#3987e5") & "'></i></div>" & "<div class='d'>" & FORMAT([High-risk customers], "#,0") & " customers above 50% risk" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>In the plan</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Share in plan]), "—", FORMAT([Share in plan], "0.0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Share in plan]) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & FORMAT([Customers in plan], "#,0") & " of " & FORMAT([Customers], "#,0") & " customers" & "</div></div>"
			    & "</div></div>"
		lineageTag: 4ff7cc55-c400-5f14-8ae6-c5a9cbd9b6fb
		displayFolder: 11 HTML panels

	/// Capacity KPIs: the October forecast with monthly history, campaign trips, load against the 80% threshold and capacity used with the reserve.
	measure 'HTML KPIs p4_capacity' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(4,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Forecast trips · 30 days</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Forecast trips]), "—", FORMAT([Forecast trips], "#,0")) & "</div>" & "<div class='sp'>" & CONCATENATEX(VALUES(monthly_trips[month_index]), VAR vMax = MAXX(ALL(monthly_trips[month_index]), CALCULATE([Monthly trips])) RETURN "<i title='" & CALCULATE(MAX(monthly_trips[month_label])) & "' style='height:" & FORMAT(MAX(0, MIN(100, (DIVIDE(CALCULATE([Monthly trips]), vMax)) * 100)), "0") & "%'></i>", "", monthly_trips[month_index], ASC) & "</div>" & "<div class='d'>" & "monthly trips to September 2025" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Campaign trips</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Campaign trips]), "—", FORMAT([Campaign trips], "+#,0;-#,0")) & "</div>" & "<div class='seg'>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Forecast trips]), MAX(0, [Forecast trips]) + MAX(0, [Campaign trips]))) * 100)), "0") & "%;background:#5b7486'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Campaign trips]), MAX(0, [Forecast trips]) + MAX(0, [Campaign trips]))) * 100)), "0") & "%;background:#3987e5'></i>" & "</div>" & "<div class='d'>" & FORMAT(DIVIDE([Campaign trips], [Forecast trips]), "0.0%") & " on top of the forecast" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Load with the campaign</span>" & IF([Load] < 0.8, "<span class='pill good'>✓ under 80%</span>", "<span class='pill warn'>▲ 80% or more</span>") & "</div><div class='v'>" & IF(ISBLANK([Load]), "—", FORMAT([Load], "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Load]) * 100)), "0") & "%;background:" & IF(([Load]) >= 0.8, "#c98500", "#3987e5") & "'></i><b style='left:80%'></b></div>" & "<div class='d'>" & [Load caption] & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Capacity committed</span>" & "" & "</div><div class='v'>" & IF(ISBLANK(DIVIDE([Forecast trips] + [Campaign trips] + [Safety reserve], [Planning capacity])), "—", FORMAT(DIVIDE([Forecast trips] + [Campaign trips] + [Safety reserve], [Planning capacity]), "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Forecast trips] + [Campaign trips] + [Safety reserve], [Planning capacity])) * 100)), "0") & "%;background:" & IF((DIVIDE([Forecast trips] + [Campaign trips] + [Safety reserve], [Planning capacity])) >= 0.95, "#c98500", "#3987e5") & "'></i></div>" & "<div class='d'>" & "forecast, campaign and 20% reserve of " & FORMAT([Planning capacity], "#,0") & "</div></div>"
			    & "</div></div>"
		lineageTag: af611776-c4c7-5763-83ca-8b563e735a4b
		displayFolder: 11 HTML panels

	/// Pricing KPIs: mean elasticity with its interval, contribution from the optimized prices, and the cells repriced.
	measure 'HTML KPIs p5_pricing' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(3,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Price elasticity</span>" & "<span class='pill info'>" & IF([Elasticity] > -1, "inelastic", "elastic") & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Elasticity]), "—", FORMAT([Elasticity], "0.00")) & "</div>" & "<div class='mv'><i style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE(([Elasticity low]) - (-2.5), ((0) - (-2.5)))) * 100)), "0") & "%;width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(([Elasticity high]) - ([Elasticity low]), ((0) - (-2.5)))) * 100)), "0") & "%;background:#2f5f8f'></i><b style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE(([Elasticity]) - (-2.5), ((0) - (-2.5)))) * 100)), "0") & "%'></b></div>" & "<div class='d'>" & [Elasticity caption] & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Contribution from prices</span>" & IF([Price contribution change] >= 0, "<span class='pill good'>✓ gain</span>", "<span class='pill warn'>✕ loss</span>") & "</div><div class='v'>" & IF(ISBLANK([Price contribution change]), "—", FORMAT([Price contribution change], "+$#,0;-$#,0")) & "</div>" & "" & "<div class='d'>" & "jointly optimized with the campaign" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Cells repriced</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Cells repriced]), "—", FORMAT([Cells repriced], "0")) & "</div>" & "<div class='dots'>" & CONCATENATEX(GENERATESERIES(1, MAX(1, [Price cells])), IF([Value] <= [Cells repriced], "<i class='on'></i>", "<i></i>"), "", [Value], ASC) & "</div>" & "<div class='d'>" & "of " & FORMAT([Price cells], "0") & " zone × period cells" & "</div></div>"
			    & "</div></div>"
		lineageTag: 2d5ecf96-85b8-57e6-a452-fcbaeceb48ba
		displayFolder: 11 HTML panels

	/// Experiment KPIs: customers per arm against the power requirement, variance removed by CUPED, and how well the causal learners rank customers.
	measure 'HTML KPIs p6_experiments' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(3,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Customers per arm</span>" & IF([Customers per arm] >= [Required per arm], "<span class='pill good'>✓ powered</span>", "<span class='pill warn'>✕ under-powered</span>") & "</div><div class='v'>" & IF(ISBLANK([Customers per arm]), "—", FORMAT([Customers per arm], "#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Customers per arm], MAX([Customers per arm], [Required per arm]) * 1.12)) * 100)), "0") & "%;background:" & IF(([Customers per arm]) >= ([Required per arm]), "#3987e5", "#c98500") & "'></i><b style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Required per arm], MAX([Customers per arm], [Required per arm]) * 1.12)) * 100)), "0") & "%'></b></div>" & "<div class='d'>" & "10 arms · power calculation needs " & FORMAT([Required per arm], "#,0") & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>CUPED variance removed</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([CUPED variance removed]), "—", FORMAT([CUPED variance removed], "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([CUPED variance removed]) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & "June trips as the pre-period covariate" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Learner rank correlation</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Learner rank correlation]), "—", FORMAT([Learner rank correlation], "0.00")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Learner rank correlation]) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & "mean ρ with the true value, all learners (simulation check)" & "</div></div>"
			    & "</div></div>"
		lineageTag: 8c0a089f-4590-5550-adc6-966773d6d3bc
		displayFolder: 11 HTML panels

	/// Policy KPIs: the optimized plan's true value against the perfect-knowledge ceiling, the ceiling, and propensity targeting against the same ceiling.
	measure 'HTML KPIs p7_policy' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(3,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Optimized plan · true value</span>" & "<span class='pill info'>" & FORMAT(DIVIDE([Optimized true value], [Value ceiling]), "0%") & " of ceiling" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Optimized true value]), "—", FORMAT([Optimized true value], "$#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Optimized true value], [Value ceiling])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & [Truth caption] & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Ceiling · perfect knowledge</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Value ceiling]), "—", FORMAT([Value ceiling], "$#,0")) & "</div>" & "" & "<div class='d'>" & "the same MIP solved on the true effects" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Propensity targeting · true value</span>" & "<span class='pill info'>" & FORMAT(DIVIDE([Propensity true value], [Value ceiling]), "0%") & " of ceiling" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Propensity true value]), "—", FORMAT([Propensity true value], "$#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Propensity true value], [Value ceiling])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & [Propensity caption] & "</div></div>"
			    & "</div></div>"
		lineageTag: f72da614-5108-59b8-9aaf-dd624e499f7c
		displayFolder: 11 HTML panels

	/// Operations KPIs: release checks passed, held-out model AUC against the 0.70 gate, flagged feed days and features above the drift threshold.
	measure 'HTML KPIs p8_operations' =
			"<div class='w'><div class='strip' style='grid-template-columns:repeat(4,1fr)'>"
			    & "<div class='kc accent'><span class='rail'></span><div class='l'><span>Release gate</span>" & IF([Checks passed] = [Checks total], "<span class='pill good'>✓ passed</span>", "<span class='pill warn'>✕ review</span>") & "</div><div class='v'>" & FORMAT([Checks passed], "0") & " / " & FORMAT([Checks total], "0") & "</div>" & "<div class='dots'>" & CONCATENATEX(GENERATESERIES(1, MAX(1, [Checks total])), IF([Value] <= [Checks passed], "<i class='on'></i>", "<i></i>"), "", [Value], ASC) & "</div>" & "<div class='d'>" & [Gate caption] & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Model AUC</span>" & "" & "</div><div class='v'>" & IF(ISBLANK([Model AUC]), "—", FORMAT([Model AUC], "0.000")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, ([Model AUC]) * 100)), "0") & "%;background:" & "#3987e5" & "'></i><b style='left:70%'></b></div>" & "<div class='d'>" & "mean of three classifiers on the July 2025 test fold · gate 0.70" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Flagged feed days</span>" & "<span class='pill info'>" & FORMAT(DIVIDE([Flagged days], [Feed days]), "0.0%") & " of days" & "</span>" & "</div><div class='v'>" & IF(ISBLANK([Flagged days]), "—", FORMAT([Flagged days], "0")) & "</div>" & "" & "<div class='d'>" & "of " & FORMAT([Feed days], "#,0") & " ingestion days, against the same-weekday median" & "</div></div>"
			    & "<div class='kc'><span class='rail'></span><div class='l'><span>Features drifting</span>" & IF([Features to review] = 0, "<span class='pill good'>✓ stable</span>", "<span class='pill warn'>▲ review</span>") & "</div><div class='v'>" & IF(ISBLANK([Features to review]), "—", FORMAT([Features to review], "0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Features to review], [Features monitored])) * 100)), "0") & "%;background:" & IF((DIVIDE([Features to review], [Features monitored])) >= 0.25, "#c98500", "#3987e5") & "'></i></div>" & "<div class='d'>" & "of " & FORMAT([Features monitored], "0") & " features above PSI 0.2" & "</div></div>"
			    & "</div></div>"
		lineageTag: edb8f9cd-5ad9-5179-93a4-c39548ae310b
		displayFolder: 11 HTML panels

	/// Command-centre banner with the plan's headline KPIs.
	measure 'HTML Hero' =
			VAR vShare = DIVIDE([Optimized true value], [Value ceiling])
			VAR vCertified = SELECTEDVALUE(plan_summary[proven_optimal])
			RETURN
			"<div class='w'><div class='hero'><div class='left'>"
			    & "<div class='eyebrow'>October 2025 · campaign plan</div>"
			    & "<div class='headline'>" & FORMAT([Contacts], "#,0") & " customers · " & FORMAT([Incentive spend], "$#,0") & " of incentives</div>"
			    & "<div class='sub'>One mixed-integer plan across " & FORMAT([Decision variables], "#,0") & " customer-offer decisions, inside budget, contact, ROI, points, inventory and 407 free-flow capacity guardrails.</div>"
			    & "<span class='badge'>" & IF(vCertified, "✓ Proven optimal", "Within solver gap") & "</span>"
			    & "<span class='badge blue'>10-arm blocked trial</span><span class='badge blue'>Synthetic data</span>"
			    & "</div><div class='kpis'>"
			    & "<div class='kpi accent'><div class='l'>Expected value</div><div class='v'>" & IF(ISBLANK([Expected value]), "—", FORMAT([Expected value], "$#,0")) & "</div>" & "<div class='seg'>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Expected 30-day net]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#3987e5'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Expected later value]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#199e70'></i>" & "<i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(MAX(0, [Relief value]), MAX(0, [Expected 30-day net]) + MAX(0, [Expected later value]) + MAX(0, [Relief value]))) * 100)), "0") & "%;background:#c98500'></i>" & "</div>" & "<div class='d'>" & FORMAT([Value per incentive dollar], "0.0") & "x the incentive spend" & "</div></div>"
			    & "<div class='kpi'><div class='l'>True value · simulation</div><div class='v'>" & IF(ISBLANK([Optimized true value]), "—", FORMAT([Optimized true value], "$#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (vShare) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & FORMAT(vShare, "0%") & " of the perfect-knowledge ceiling" & "</div></div>"
			    & "<div class='kpi'><div class='l'>Net ROI · 30 days</div><div class='v'>" & IF(ISBLANK([Net ROI]), "—", FORMAT([Net ROI], "0%")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Net ROI], MAX([Net ROI], [ROI floor]) * 1.12)) * 100)), "0") & "%;background:" & IF(([Net ROI]) >= ([ROI floor]), "#3987e5", "#c98500") & "'></i><b style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE([ROI floor], MAX([Net ROI], [ROI floor]) * 1.12)) * 100)), "0") & "%'></b></div>" & "<div class='d'>" & "floor " & FORMAT([ROI floor], "0%") & "</div></div>"
			    & "<div class='kpi'><div class='l'>Rush-hour trips / workday</div><div class='v'>" & IF(ISBLANK([Rush-hour trips per workday]), "—", FORMAT([Rush-hour trips per workday], "+#,0;-#,0")) & "</div>" & "<div class='mv'><i style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE([Relief value], [Expected value])) * 100)), "0") & "%;background:" & "#3987e5" & "'></i></div>" & "<div class='d'>" & "moved onto the 407, worth " & FORMAT([Relief value], "$#,0") & "</div></div>"
			    & "</div></div></div>"
		lineageTag: 3dea072f-071c-5160-87fb-fe33cbb2b7a0
		displayFolder: 11 HTML panels

	/// One card per offer: contacts, expected value, spend.
	measure 'HTML Offer cards' =
			VAR vMax = MAXX(ALL(dim_offer), [Expected value])
			RETURN
			"<div class='w'><div class='h'>Offers in the plan · contacts, expected value and spend</div><div class='cards'>"
			    & CONCATENATEX(
			        ALL(dim_offer),
			        "<div class='card" & IF(COALESCE([Contacts], 0) = 0, " idle", "") & "'><div class='top'><div><div class='n'><span class='dot' style='background:" & dim_offer[offer_fill] & "'></span>" & dim_offer[offer_name] & "</div>"
			            & "<div class='t'>" & dim_offer[offer_type] & " · " & IF(dim_offer[period] = "Mixed", "any period", "fills " & dim_offer[period]) & "</div></div>"
			            & "<div class='big'>" & FORMAT(COALESCE([Expected value], 0), "$#,0") & "</div></div>"
			            & "<div class='t'>" & FORMAT(COALESCE([Contacts], 0), "#,0") & " contacts · " & FORMAT(COALESCE([Incentive spend], 0), "$#,0") & " spend" & IF(COALESCE([Contacts], 0) = 0, " · not worth a contact under these limits", "") & "</div>"
			            & "<div class='track'><div class='fill' style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(COALESCE([Expected value], 0), vMax)) * 100)), "0") & "%;background:" & dim_offer[offer_fill] & "'></div></div></div>",
			        "", dim_offer[offer_order], ASC)
			    & "</div></div>"
		lineageTag: 3cb65860-eabb-5b1a-a8e4-6fca331695b3
		displayFolder: 11 HTML panels

	/// Binding guardrails with their LP shadow prices.
	measure 'HTML Guardrails' =
			VAR vTop = TOPN(1, guardrails, guardrails[shadow_price], DESC)
			RETURN
			"<div class='w'><div class='h'>Binding guardrails · what one more unit is worth (LP duals)</div>"
			    & "<table class='t'><tr><th>Guardrail</th><th class='num'>Limit</th><th class='num'>Value of +1</th></tr>"
			    & CONCATENATEX(
			        guardrails,
			        "<tr><td>" & guardrails[constraint_label] & "</td><td class='num'>" & FORMAT(guardrails[limit], "#,0") & "</td><td class='num'>" & FORMAT(guardrails[shadow_price], "$#,0.00") & "</td></tr>",
			        "", guardrails[shadow_price], DESC)
			    & "</table><div class='note'>Relax first: <b>" & MAXX(vTop, guardrails[constraint_label]) & "</b>, worth " & FORMAT(MAXX(vTop, guardrails[shadow_price]), "$#,0.00") & " per extra unit. Guardrails that do not bind are worth nothing at the margin and are not listed.</div></div>"
		lineageTag: 54a0df24-7690-50af-ad7d-241e34ecbe12
		displayFolder: 11 HTML panels

	/// Targeting approaches ranked by true value.
	measure 'HTML Policy leaderboard' =
			VAR vCeiling = [Value ceiling]
			RETURN
			"<div class='w'><div class='h'>Targeting approaches scored against the simulator's truth</div>"
			    & "<table class='t'><tr><th>Approach</th><th class='num'>True value</th><th></th><th class='num'>Ceiling</th></tr>"
			    & CONCATENATEX(
			        ALL(policy_comparison),
			        "<tr" & IF(policy_comparison[policy] = "Optimized (MIP)", " class='hl'", "") & "><td>" & policy_comparison[policy] & "</td><td class='num'>" & FORMAT(policy_comparison[true_value], "$#,0") & "</td><td style='width:34%'><div class='track'><div class='fill' style='width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(policy_comparison[true_value], vCeiling)) * 100)), "0") & "%;background:" & SWITCH(TRUE(), policy_comparison[policy] = "Optimized (MIP)", "#3987e5", LEFT(policy_comparison[policy], 6) = "Oracle", "#86b6ef", "#5b7486") & "'></div></div></td><td class='num'>" & FORMAT(DIVIDE(policy_comparison[true_value], vCeiling), "0%") & "</td></tr>",
			        "", policy_comparison[true_value], DESC)
			    & "</table></div>"
		lineageTag: 7fee8619-ed13-57e3-9427-7ca5e743f518
		displayFolder: 11 HTML panels

	/// Trial effects with Bonferroni intervals.
	measure 'HTML Experiment forest' =
			VAR vLow = MINX(ALL(experiment_effects), experiment_effects[value_low])
			VAR vHigh = MAXX(ALL(experiment_effects), experiment_effects[value_high])
			VAR vSpan = MAX(vHigh - vLow, 0.01)
			VAR vZero = FORMAT(MAX(0, MIN(100, (DIVIDE(0 - vLow, vSpan)) * 100)), "0")
			RETURN
			"<div class='w'><div class='h'>30-day net contribution per randomised customer · CUPED, Bonferroni 95%</div>"
			    & CONCATENATEX(
			        ALL(experiment_effects),
			        "<div class='fr'><span>" & RELATED(dim_offer[offer_name]) & "</span><div class='lane'>"
			            & "<div class='zero' style='left:" & vZero & "%'></div>"
			            & "<div class='ci' style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE(experiment_effects[value_low] - vLow, vSpan)) * 100)), "0") & "%;width:" & FORMAT(MAX(0, MIN(100, (DIVIDE(experiment_effects[value_high] - experiment_effects[value_low], vSpan)) * 100)), "0") & "%'></div>"
			            & "<div class='pt' style='left:" & FORMAT(MAX(0, MIN(100, (DIVIDE(experiment_effects[value_effect] - vLow, vSpan)) * 100)), "0") & "%;background:" & IF(experiment_effects[value_effect] < 0, "#e66767", "#3987e5") & "'></div></div><span class='num'>" & FORMAT(experiment_effects[value_effect], "+$0.00;-$0.00") & "</span></div>",
			        "", experiment_effects[value_effect], DESC)
			    & "<div class='note'>Red: loses money on the average randomised customer. The plan still uses an offer where the models find customers it moves.</div></div>"
		lineageTag: ed68dc5f-9ba4-5bff-9184-e6925d82c07f
		displayFolder: 11 HTML panels

	/// Zone x period load heat grid.
	measure 'HTML Capacity grid' =
			VAR vColumns = COUNTROWS(VALUES(dim_period[period]))
			RETURN
			"<div class='w'><div class='h'>Load by zone and period, with the campaign (share of free-flow capacity)</div><div class='grid' style='grid-template-columns:96px repeat(" & vColumns & ",1fr)'><div></div>"
			    & CONCATENATEX(VALUES(dim_period[period]), "<div class='gh'>" & dim_period[period] & "</div>", "", CALCULATE(MAX(dim_period[period_order])), ASC)
			    & CONCATENATEX(
			        VALUES(dim_zone[zone_name]),
			        "<div class='gz'>" & dim_zone[zone_name] & "</div>" & CONCATENATEX(
			            VALUES(dim_period[period]),
			            VAR vLoad = CALCULATE([Load])
			            VAR vTone = IF(vLoad >= 0.8, "201,133,0", "57,135,229")
			            RETURN "<div class='cell' style='background:rgba(" & vTone & "," & FORMAT(MAX(0.12, MIN(0.95, vLoad)), "0.00") & ")'>" & FORMAT(vLoad, "0%") & "<small>" & FORMAT(CALCULATE([Free after campaign]), "#,0") & " free</small></div>",
			            "", CALCULATE(MAX(dim_period[period_order])), ASC),
			        "", CALCULATE(MAX(dim_zone[zone_order])), ASC)
			    & "</div><div class='note'>Amber: 80% of capacity or more, where rush-hour offers are held back.</div></div>"
		lineageTag: 8529f9eb-e645-5b58-9c23-01554746d0e3
		displayFolder: 11 HTML panels

	/// Segment table with plan share bars.
	measure 'HTML Segments' =
			"<div class='w'><div class='h'>Segments · risk, value and what the plan does with them</div>"
			    & "<table class='t'><tr><th>Segment</th><th class='num'>Customers</th><th class='num'>Propensity</th><th class='num'>Inactivity</th><th class='num'>Best-offer value</th><th>In plan</th></tr>"
			    & CONCATENATEX(
			        VALUES(customer_segments[rfm_segment]),
			        "<tr><td>" & customer_segments[rfm_segment] & "</td><td class='num'>" & FORMAT([Customers], "#,0") & "</td><td class='num'>" & FORMAT([Mean travel propensity], "0%") & "</td><td class='num'>" & IF(ISBLANK([Mean inactivity risk]), "—", FORMAT([Mean inactivity risk], "0%")) & "</td><td class='num'>" & FORMAT([Mean best-offer value], "$0.00") & "</td><td style='width:24%'><div class='track'><div class='fill' style='width:" & FORMAT(MAX(0, MIN(100, ([Share in plan]) * 100)), "0") & "%;background:#4bdcd5'></div></div></td></tr>",
			        "", CALCULATE(MAX(customer_segments[segment_order])), ASC)
			    & "</table></div>"
		lineageTag: a1da1406-36d6-5113-89a4-57cc8984d797
		displayFolder: 11 HTML panels

	/// Acceptance gate and model quality.
	measure 'HTML Scorecard' =
			"<div class='w'><div class='h'>Release acceptance gate</div><table class='t'>"
			    & CONCATENATEX(
			        quality_gate,
			        "<tr><td>" & IF(quality_gate[passed], "<span class='ok'>✓</span>", "<span class='no'>✕</span>") & " " & quality_gate[check_name] & "</td><td class='note'>" & quality_gate[criteria] & "</td></tr>",
			        "")
			    & "</table><div class='h' style='margin-top:10px'>Customer models · July 2025 test fold</div><table class='t'><tr><th>Model</th><th>Champion</th><th class='num'>AUC</th><th class='num'>Brier</th><th class='num'>ECE</th></tr>"
			    & CONCATENATEX(
			        model_quality,
			        "<tr><td>" & model_quality[model] & "</td><td>" & model_quality[champion] & "</td><td class='num'>" & FORMAT(model_quality[auc], "0.000") & "</td><td class='num'>" & FORMAT(model_quality[brier], "0.000") & "</td><td class='num'>" & FORMAT(model_quality[ece], "0.000") & "</td></tr>",
			        "")
			    & "</table></div>"
		lineageTag: 8853c8e3-803b-5df3-8596-033b8b151266
		displayFolder: 11 HTML panels

	/// The executive summary as a styled paragraph.
	measure 'HTML Narrative' =
			"<div class='w'><div class='eyebrow'>In plain language</div><div style='font-size:14px;line-height:1.55;margin-top:8px;color:#d8ecf4'>" & [Executive summary] & "</div></div>"
		lineageTag: edecda25-e864-58f5-b6dd-44db30ccca4c
		displayFolder: 11 HTML panels

	column _placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 865fa469-fa8e-55ca-9b96-396829edd734
		summarizeBy: none
		sourceColumn: _placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [_placeholder = Int64.Type], {{0}})
				in
				    Source
