	measure 'KPI SVG Expected value | Value caption @314' =
			VAR vValue = [Expected value]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "\$#,0.00") & "M", FORMAT(vValue, "\$#,0")))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Value caption], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 61, LEFT(vCaptionRaw, 59) & "…", vCaptionRaw)
			VAR vTone = "#8faebf"
			VAR vArrow = ""
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='314' height='112' viewBox='0 0 314 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='#4bdcd5'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#b3c7d7'>Expected value</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#eef8ff'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='" & vTone & "'>" & vArrow & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 7a771f22-701c-5d61-9279-cf23a761249b
		dataCategory: ImageUrl
		displayFolder: Report UI

