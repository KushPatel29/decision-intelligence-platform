			        & "<text x='0' y='24' font-family='Segoe UI Semibold' font-size='18' fill='#eef8ff'>Command centre</text>"
			        & "<text x='0' y='46' font-family='Segoe UI' font-size='11' fill='#8faebf'>" & vContext & "</text>"
			        & "</svg>"
			RETURN
